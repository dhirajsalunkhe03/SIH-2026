# SIH 2026 PS45 - Legal RAG Pipeline Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================
# BASE PATHS (auto-detected if not set)
# ============================================================
# RAG_BASE_DIR=/home/dhiraj/Desktop/SIH/rag_pipeline
# RAG_VECTOR_DB_PATH=/home/dhiraj/Desktop/SIH/rag_pipeline/vector_db
# RAG_LOGS_DIR=/home/dhiraj/Desktop/SIH/rag_pipeline/logs
# RAG_OUTPUT_DIR=/home/dhiraj/Desktop/SIH/rag_pipeline/output

# ============================================================
# RETRIEVER / EMBEDDING CONFIGURATION
# ============================================================
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cuda
RAG_EMBEDDING_USE_CPU=true
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_MAX_SEQ_LEN=512
RAG_COLLECTION_NAME=legal_knowledge
RAG_DEFAULT_TOP_K=5

# ============================================================
# OLLAMA / QWEN3 CONFIGURATION
# ============================================================
RAG_OLLAMA_MODEL=qwen3:4b
RAG_OLLAMA_HOST=http://localhost:11434
RAG_OLLAMA_TEMPERATURE=0.1
RAG_OLLAMA_TOP_P=0.9
RAG_OLLAMA_MAX_TOKENS=512
RAG_OLLAMA_TIMEOUT=120

# ============================================================
# TRANSLATION (NLLB-200) CONFIGURATION
# ============================================================
RAG_TRANSLATION_ENABLED=true
RAG_TRANSLATION_DEVICE=cuda
RAG_TRANSLATION_DTYPE=float16
RAG_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
RAG_TRANSLATION_MAX_LEN=512
RAG_TRANSLATION_NUM_BEAMS=5
RAG_TRANSLATION_CPU_FALLBACK=true

# ============================================================
# CONTEXT / RETRIEVAL THRESHOLDS
# ============================================================
RAG_MAX_CONTEXT_CHARS=1500
RAG_MAX_SOURCES=3
RAG_HIGH_CONFIDENCE=0.6
RAG_MEDIUM_CONFIDENCE=0.4
RAG_LOW_CONFIDENCE=0.25
RAG_NO_CONTEXT_THRESHOLD=0.15
RAG_MIN_SCORE_GENERATION=0.3

# ============================================================
# API SERVER CONFIGURATION
# ============================================================
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
RAG_API_REQUEST_TIMEOUT=180
RAG_API_WORKERS=1
# Rate limiting (requests per window, set to 0 to disable)
RAG_API_RATE_LIMIT=60
RAG_API_RATE_WINDOW=60

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
RAG_LOG_LEVEL=INFO